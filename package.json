{
  "name": "tailorae",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "node tools/gradle.mjs bootRun",
    "build": "npm run build:api && npm run build:web",
    "build:web": "npm run build --prefix apps/web",
    "build:api": "node tools/gradle.mjs bootJar",
    "start": "npm start --prefix apps/web",
    "install:all": "npm install --prefix apps/web --legacy-peer-deps",
    "lint": "npm run lint --prefix apps/web",
    "type-check": "npm run type-check --prefix apps/web",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node tools/gradle.mjs test",
    "test:web": "npx --prefix apps/web vitest run --root apps/web",
    "api:types": "npm run api:types --prefix apps/web",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:up": "docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml up -d",
    "db:down": "docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml down",
    "stack:up": "docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml --profile app up -d --build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
