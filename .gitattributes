# Normalise text to LF in the repository; Git converts on checkout per platform.
* text=auto

# Shell scripts must stay LF everywhere, or they fail inside Linux containers and CI.
*.sh text eol=lf
apps/api/gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.gif binary
*.pdf binary
*.xlsx binary
*.jar binary
*.woff binary
*.woff2 binary
