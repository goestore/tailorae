# Production settings for docker-compose.prod.yml. Copy to the server as
# ~/tailorae.env (never into the repo) and fill in every value.
# Generate secrets with:  openssl rand -base64 48

# Domains (DNS A records must point at the server before the first start)
WEB_DOMAIN=tailorae.com
API_DOMAIN=api.tailorae.com

# Database (Postgres runs on the same server)
DATABASE_USER=tailorae
DATABASE_PASSWORD=

# Auth
JWT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
# Encrypts seller bank account numbers. LOSING IT MAKES THEM UNREADABLE. Back it up; never change it.
FIELD_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Shared with the web app
CONTENT_REVALIDATE_SECRET=

# Files on S3
STORAGE_SIGNING_KEY=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
# Saved into the database with every upload — set it right before the first upload.
S3_PUBLIC_BASE_URL=https://<public-bucket>.s3.ap-south-1.amazonaws.com

# Email (e.g. Amazon SES SMTP: email-smtp.ap-south-1.amazonaws.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TAILORAE <no-reply@tailorae.com>
ADMIN_EMAIL=

# Payments (empty = cash on delivery only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# No SMS provider yet. true = seller phone codes are printed in the API log.
TAILORAE_SMS_LOG_CODES=false

# Contact details shown on the site (baked in when the web image is built)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_ADDRESS=
