# Frontend Environment Variables

# API Configuration - REQUIRED
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Payment Gateway Keys (optional, add as needed)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Content publishing
# Must match CONTENT_REVALIDATE_SECRET in the backend environment. Server-side
# only — no NEXT_PUBLIC_ prefix, so it is never sent to the browser.
CONTENT_REVALIDATE_SECRET=change_me_to_a_long_random_string
