# Frontend Environment Variables

# API Configuration - REQUIRED
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public site origin - REQUIRED in production, and load-bearing rather than
# cosmetic: it is the base for every canonical link, the Open Graph URLs and
# images, robots.txt and sitemap.xml. Left at localhost on a live site, every
# canonical points at a machine nobody can reach, which is worse than not
# emitting one at all.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Payments
#
# Nothing to set. The Razorpay key id the browser needs is served by the backend
# at GET /api/payments/config, alongside whether online payment is available at
# all and, when it is not, the reason to show the customer.
#
# That is on purpose: a key duplicated here is one that can disagree with the
# backend's, which fails at the moment the customer pays rather than at deploy.
# One source, read at runtime, and checkout disables the option honestly when
# the backend says the gateway is unconfigured.
#
# The Razorpay Checkout script is loaded from checkout.razorpay.com on demand;
# it is not bundled and needs no key at build time.

# Content publishing
# Must match CONTENT_REVALIDATE_SECRET in the backend environment. Server-side
# only — no NEXT_PUBLIC_ prefix, so it is never sent to the browser.
CONTENT_REVALIDATE_SECRET=change_me_to_a_long_random_string
