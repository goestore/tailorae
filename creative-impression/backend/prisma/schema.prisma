// ============================================
// STOREFRONT CAPTURE
// ============================================

// Footer / homepage newsletter signups. Re-subscribing an address is a no-op
// rather than an error, so the endpoint never reveals who is already on the
// list.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("footer")
  isSubscribed   Boolean   @default(true)
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isSubscribed])
}

// "Notify me when this is back in stock" signups, per product and (optionally)
// per size variant. `notifiedAt` is set once the restock mail goes out so the
// same shopper is not mailed twice for one restock.
model StockNotification {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email      String
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  // Postgres treats NULLs as distinct, so this only enforces uniqueness for
  // variant-level signups; the route de-dupes product-level ones in code.
  @@unique([productId, variantId, email])
  @@index([productId])
  @@index([notifiedAt])
}

// ============================================
// BRANDS
// ============================================

/// A label a product is sold under.
///
/// Distinct from VendorProfile on purpose, the way it is on any marketplace:
/// the brand is whose name is on the garment, the vendor is who sells it. One
/// seller lists many brands, and one brand is sold by many sellers, so folding
/// them together would make both unusable as a filter.
model Brand {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String?
  /// Square mark for the brand rail and the brand page header.
  logo         String?
  /// Wide image for the top of the brand page.
  banner       String?
  /// Surfaced on the homepage brand rail.
  isFeatured   Boolean @default(false)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  /// The shop that added this brand from the listing form. Until an admin
  /// approves it (isActive), only that shop may list under it. Null for
  /// brands the platform added.
  ownerVendorId String?
  ownerVendor   VendorProfile? @relation(fields: [ownerVendorId], references: [id], onDelete: SetNull)

  /// Seller-registered brands start PENDING. Approving also sets isActive.
  status            BrandStatus @default(APPROVED)
  /// Trademark certificate or authorised-reseller letter. Private storage
  /// (private-uploads/), never under /uploads.
  authorizationDoc  String?
  /// TRADEMARK_OWNER | AUTHORISED_RESELLER
  authorizationType String?
  rejectionReason   String?

  // SEO
  metaTitle       String?
  metaDescription String?

  // Relations
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
}

// ============================================
// MARKETPLACE SETTLEMENT
// ============================================

/// One seller's half of an order.
///
/// An order is placed once and paid once, but fulfilled and settled per shop:
/// shop A can have shipped while shop B is still packing, and each is owed a
/// different amount. Without this row there is nothing to compute a commission
/// against and nothing to pay out.
///
/// `commissionRate` is a snapshot, not a lookup. Rates change; what a seller
/// was owed for an order placed in March must not move when their rate is
/// renegotiated in June.
model SellerOrder {
  id          String @id @default(cuid())
  /// Parent order number plus a letter: CI-1234-A, CI-1234-B.
  orderNumber String @unique

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Null for house stock — the platform's own listings, which owe no commission.
  vendorId String?
  vendor   VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  /// This shop's part moves through fulfilment on its own.
  status OrderStatus @default(PENDING)

  /// Money, all shares of the parent order and summing exactly back to it.
  subtotal         Float
  discount         Float @default(0)
  shippingCost     Float @default(0)
  total            Float
  commissionRate   Float @default(0)
  commissionAmount Float @default(0)
  /// What the seller is owed: net of discount and commission, excluding shipping.
  payoutAmount     Float @default(0)

  /// Set once the payout has actually been settled.
  settledAt DateTime?

  // Fulfilment, per shop
  trackingNumber String?
  carrier        String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@index([settledAt])
}

/// Every money movement between the platform and a seller. The balance is the
/// sum of amounts: positive means the platform owes the seller.
model SellerLedgerEntry {
  id            String          @id @default(cuid())
  vendorId      String
  vendor        VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sellerOrderId String?
  type          LedgerEntryType
  /// Rupees. SALE positive; PAYOUT and RETURN_REVERSAL negative.
  amount        Float
  /// Bank / UTR reference for payouts.
  reference     String?
  note          String?
  createdBy     String?

  createdAt DateTime @default(now())

  @@index([vendorId, createdAt])
  @@index([sellerOrderId])
}

// ============================================
// CUSTOM WEAR QUOTES
// ============================================

/// A request for custom-printed or embroidered garments from /custom-wear.
/// Priced by a person, so it is a quote rather than an order.
model CustomWearQuote {
  id        String  @id @default(cuid())
  reference String  @unique // CWQ-<year>-<6 digits>
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  productId   String // custom-wear catalogue id (static catalogue, not Product)
  productSlug String
  productName String
  sku         String
  colorName   String?
  sizes       String[]
  quantity    Int
  method      String?
  locations   String[]
  designFiles String[] // uploaded artwork URLs or names
  notes       String?

  customerName String
  company      String?
  email        String
  phone        String?
  country      String
  postcode     String?
  requiredBy   String?

  status      String  @default("NEW") // NEW, CONTACTED, QUOTED, WON, LOST
  quotedPrice Float?
  adminNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([userId])
}
