// ============================================
// AUDIT & LOGGING
// ============================================

/// One editable storefront value, addressed by namespace + JSON pointer.
///
/// Stored per field rather than as a document per namespace. Two admins
/// editing different fields cannot clobber each other, the audit trail names
/// the exact value that changed, and a rollback can undo one field instead of
/// a whole page. Paths are validated against the frontend content registry
/// before a row is written, so an unknown path is never persisted.
///
/// Absence is normal: the storefront falls back to its compiled defaults, so
/// an empty table renders the site exactly as it ships.
model ContentValue {
  id        String @id @default(cuid())
  namespace String // "brand", "custom-wear"
  path      String // JSON pointer, e.g. "/announcement/message"
  value     Json

  /// DRAFT is visible only in preview; PUBLISHED is what the storefront reads.
  status  String @default("DRAFT")
  version Int    @default(1)

  /// Set from the registry's `field.private` when the value is written, and
  /// filtered out of the public read.
  ///
  /// The flag has to live on the row because only the writer knows it: the
  /// registry that declares which fields are sensitive is a frontend module,
  /// so the public endpoint cannot look it up. Filtering on the client would
  /// be theatre — by then the value has already been sent.
  isPrivate Boolean @default(false)

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// One row per field per version, so history is append-only rather than
  /// overwritten in place.
  @@unique([namespace, path, version])
  @@index([namespace, status])
  @@index([updatedById])
}

/// An uploaded image, normalised and stored on disk.
///
/// The row is the record; the file on disk is derived from it. Every upload is
/// re-encoded to webp and named by the hash of its bytes, which makes the same
/// image uploaded twice one row and one file rather than two of each.
model MediaAsset {
  id String @id @default(cuid())

  /// Content hash of the stored bytes. Also the filename stem, so the URL is
  /// immutable and safe to cache forever.
  hash String @unique

  /// Public path the storefront uses, e.g. "/uploads/ab12….webp".
  url String

  /// What the uploader called it. Shown in the picker; never used as a path.
  filename String

  /// Description for screen readers. Empty until someone fills it in.
  alt String @default("")

  width  Int
  height Int
  bytes  Int

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([uploadedById])
}

model AuditLog {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // CREATE, UPDATE, DELETE
  resource   String // Product, Order, User, etc.
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
}

