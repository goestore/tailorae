# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/creative_impression"

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
#
# JWT_SECRET is required and the server refuses to start without it. It used to
# fall back to the literal string 'secret' when unset, which is published in
# every clone of this repository — one missing variable and anyone could sign
# themselves an admin token, with nothing about the running server looking
# wrong. Use at least 32 characters of random data:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The value below is the placeholder and is rejected outright under
# NODE_ENV=production; anywhere else a weak or short secret only logs a warning
# so local work is not blocked.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# How long a sign-in lasts. Sessions are revocable now (see AuthSession), so
# logging out or resetting a password ends a token before this elapses.
JWT_EXPIRE=7d

# Frontend URL (for CORS)
#
# Also builds the password-reset link that customers are emailed, so in
# production this has to be the public site address — a localhost value here
# sends out reset links nobody can open.
FRONTEND_URL=http://localhost:3000

# Public address of THIS API.
#
# Only used to build the email-confirmation link, which is answered by the API
# rather than the storefront. Defaults to http://localhost:<PORT>, which is
# right for local development and wrong for anything else.
# API_URL=https://api.creativeimpression.in

# Payments (Razorpay)
#
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET together are the switch. Unset, the
# online payment option is disabled in checkout with the reason shown to the
# customer, the payment endpoints answer 503 saying the same thing, and every
# skipped gateway call is written to the log as `[pay:log] ...`. Cash on
# delivery is unaffected and keeps working throughout. Set both and online
# payment starts being offered with no other change.
#
# Deliberately unlike the mailer, nothing here degrades to "pretend it worked":
# an unsent email costs nothing, but an order marked paid that nobody paid for
# is the one failure this integration must never produce.
#
# The key id is the publishable half — it is sent to the browser so Razorpay
# Checkout can open. The secret never leaves the server; it verifies the
# checkout handshake at POST /api/payments/razorpay/verify.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret
#
# A SEPARATE secret, configured under Settings > Webhooks in the Razorpay
# dashboard rather than alongside the API keys, and not interchangeable with
# RAZORPAY_KEY_SECRET. It signs the webhook body, and without it
# POST /api/payments/razorpay/webhook answers 503 rather than trusting an
# unverified caller.
#
# The webhook is what makes the money side correct: a customer who closes the
# tab after paying never calls /verify, and this is the only path that records
# their payment. Point the dashboard at
# <public URL>/api/payments/razorpay/webhook and subscribe to payment.captured,
# payment.authorized, payment.failed and refund.processed. In local development
# use a tunnel — Razorpay cannot reach localhost.
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
#
# Stripe and PayPal are in package.json and imported by no file. Their endpoints
# were removed rather than left answering 501; the storefront prices in rupees
# and sells in India, so Razorpay is the whole requirement.

# AWS Configuration (if using S3 for file uploads)
# AWS_ACCESS_KEY_ID=your_aws_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_s3_bucket_name

# Email
# SMTP_HOST is the switch: unset, every message is written to the log with its
# recipient and subject instead of being sent, and nothing fails. Set it and the
# order confirmation, order status and back-in-stock mails start going out with
# no other change. Port 465 is treated as implicit TLS; 587 and 25 use STARTTLS.
# SMTP_USER/SMTP_PASS may both be omitted for a relay that does not authenticate.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_smtp_password
# MAIL_FROM=Creative Impression <no-reply@creativeimpression.in>
#
# FRONTEND_URL above is also what builds the track-order and invoice links
# inside those emails, so it has to be the public site address in production,
# not localhost.
#
# Password reset and email confirmation go through the same switch. While
# SMTP_HOST is unset those messages are logged rather than sent, and because
# nobody could have received them the log line is followed by an
# `[auth:link] ...` line carrying the full link, so a developer can complete
# the flow. Configure SMTP_HOST and those link lines stop appearing on their
# own — the link is never put in an API response, in any environment.

# Delivery estimates
# Optional cap on the in-memory pincode lookup cache. Defaults to 5000 entries.
# PINCODE_CACHE_MAX=5000

# Admin Configuration
ADMIN_EMAIL=admin@creative-impression.local

# Content publishing
# Shared with the frontend. After a publish the backend calls
# FRONTEND_URL/api/content/revalidate with this secret so the storefront drops
# its cached copy. Unset, publishes are saved but stay invisible until the
# frontend cache expires on its own.
CONTENT_REVALIDATE_SECRET=change_me_to_a_long_random_string

# Encrypts seller bank account numbers at rest (AES-256-GCM). Required in
# production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes stored account numbers unreadable, so back it up with the DB.
FIELD_ENCRYPTION_KEY=
