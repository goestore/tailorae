# Local settings for `npm run dev:api` (copy to apps/api/.env — it is git-ignored).
# Spring Boot reads this file on start (spring.config.import in application.yml).

# Signs session tokens. Any long random string (e.g. `openssl rand -base64 48`).
JWT_SECRET=
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts seller bank account numbers.
FIELD_ENCRYPTION_KEY=

# Plain http on localhost needs non-Secure cookies.
SECURE_COOKIES=false

# The first staff account (SUPER_ADMIN), created on start if no staff account has this email.
BOOTSTRAP_ADMIN_EMAIL=admin@tailorae.com
BOOTSTRAP_ADMIN_PASSWORD=

# Defaults that match `npm run db:up` (Postgres on 5433, Kafka on 9092, Mailpit on 1025).
# DATABASE_URL=jdbc:postgresql://localhost:5433/tailorae_api
# WEB_ORIGINS=http://localhost:3000
# WEB_URL=http://localhost:3000

# Razorpay test keys turn on online payment; leave empty for cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phone codes are printed to the log instead of texted until an SMS provider is set up.
TAILORAE_SMS_LOG_CODES=true
